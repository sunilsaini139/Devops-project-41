Update 3:-

Create file "sonar-project.properities" in project root

sonar.projectKey=swiggy-clone
sonar.projectName=swiggy-clone
sonar.projectVersion=0.1.0

# Sources and tests
sonar.sources=src
sonar.tests=src
sonar.test.inclusions=**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx
sonar.exclusions=**/node_modules/**,**/*.css,**/Photos/**,**/public/**

# Coverage
sonar.javascript.lcov.reportPaths=coverage/lcov.info

# Don't count CSS / images / entry point as "to be covered"
sonar.coverage.exclusions=\
  src/index.js,\
  src/**/*.css,\
  src/Photos/**,\
  src/**/*.test.js,\
  src/**/*.test.jsx



